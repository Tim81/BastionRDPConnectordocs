---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => {
    // Entry ids are "en/overview", "en/connection-methods", etc. English is
    // the default locale (prefixDefaultLocale: false in astro.config.mjs),
    // so its route sits at the base root; other locales, once they exist,
    // route at "<locale>/<slug>".
    const [locale, ...rest] = entry.id.split('/');
    const slug = rest.join('/');
    const routeSlug = locale === 'en' ? slug : `${locale}/${slug}`;
    return {
      params: { slug: routeSlug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  appliesTo={entry.data.appliesTo}
  lastReviewed={entry.data.lastReviewed}
  slug={slug}
  headings={headings}
>
  <Content />
</DocsLayout>
