---
import Rail from '../components/Rail.astro';
import Toc from '../components/Toc.astro';
import Pager from '../components/Pager.astro';
import { baseHref, pageHref, groupKeyFor } from '../nav';
import { t } from '../i18n';
import '../styles/site.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  appliesTo: string;
  lastReviewed: string;
  slug: string;
  locale: string;
  headings: Heading[];
}

const { title, description, appliesTo, lastReviewed, slug, locale, headings } = Astro.props;
const groupKey = groupKeyFor(slug);
const groupTitle = groupKey ? t(locale, `group.${groupKey}`) : '';
---
<html lang={locale}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} · Azure Bastion RDP Connector</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@800&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;650&display=swap" rel="stylesheet" />
</head>
<body>

<Rail current={slug} locale={locale} />

<main class="page">
<div class="cols">
<article>

  <p class="crumb"><a href={baseHref()}>{t(locale, 'home')}</a><span>/</span><a href={pageHref('overview', locale)}>{t(locale, 'docs')}</a><span>/</span>{groupTitle}<span>/</span>{title}</p>

  <h1>{title}</h1>
  <slot />

  <p class="meta">{t(locale, 'appliesTo')} {appliesTo} · {t(locale, 'lastReviewed')} {lastReviewed}</p>

  <Pager current={slug} locale={locale} />

</article>

<Toc headings={headings} locale={locale} />
</div>
</main>

</body>
</html>
