---
// Schematic of the Azure VM tab. Exemplar for every other screen figure.
//
// Drawn from MainWindow.axaml and MainWindow.Connection.cs, with every label
// resolved through ui-strings.ts. Four things the first version got wrong
// and that must stay right:
//
// 1. The panels are mutually exclusive. UpdateConnectionMethodUI hides the
//    port fields under RD Gateway, and hides Monitor Configuration and the
//    Entra ID option under Tunnel. Never draw all four at once.
// 2. Use EntraID Authentication ships unchecked (IsChecked="False"), with
//    grey help text beneath it.
// 3. No label is written by hand. The German screen once said "Monitore"
//    where the application says "Monitor-Konfiguration".
// 4. Nothing is positioned off an English label's width. German runs far
//    longer — "Aktualisieren", "Abmelden", "VM-Abonnement" — so buttons are
//    sized from their own label and each control starts where the previous
//    label actually ends.
//
// The platform prop is not decoration. Windows draws its three caption
// glyphs and selects RD Gateway; macOS draws traffic lights with a centred
// title and selects Tunnel. That is the real platform default, chosen in
// MainWindow.Layout.cs when no preference has been saved yet.
import { s, tw, btnW, fit, wrap, LANG_NAME, LANG_FLAG, type Lang } from './screen';

interface Props { platform?: 'windows' | 'macos'; lang?: Lang; caption?: string; }
const { platform = 'windows', lang = 'en', caption } = Astro.props as Props;

const mac = platform === 'macos';
const t = (k: string) => s(k, lang);

// Type sizes. The window is drawn at ~0.47 scale, so the right column and the
// button captions sit a step below the ordinary label size.
const F = 7;      // ordinary control label
const F_S = 6.1;  // dense right column and button captions
const F_XS = 5.6; // grey help text

// Row 0 — Logout is a DangerButton; both it and Change hug the right edge.
const wLogout = btnW(t('Logout'), F_S, 12, 34);
const xLogout = 290 - wLogout;
const wChange = btnW(t('Change'), F_S, 12, 34);
const xChange = 290 - wChange;

// Row 1 — Bastion label, then the combo, then Refresh against the right edge.
const wRefresh = btnW(t('Refresh'), F_S, 14, 40);
const xRefresh = 290 - wRefresh;
const xBastionField = 14 + tw(t('Bastion'), F);
const wBastionField = xRefresh - 6 - xBastionField;

// Tabs sit left to right in their own widths.
const xTab2 = 18 + tw(t('TabIPAddress'), F);
const xTab3 = xTab2 + tw(t('TabAzureVM'), F) + 10;

// Radio pairs: the second control starts after the first label ends.
const methodX2 = 16 + 8 + tw(t('ConnectionMethodTunnel'), F) + 10;
const monitorX2 = 16 + 8 + tw(t('SingleMonitor'), F_S) + 9;
const vmModeX2 = 161 + 7 + tw(t('SearchCurrentSubscription'), F_S) + 8;

// Right column: the two Refresh buttons hug the right edge, combos take the rest.
const wRefreshVm = btnW(t('Refresh'), F_S, 10, 30);
const xRefreshVm = 290 - wRefreshVm;
const wCombo = xRefreshVm - 4 - 156;

// Power state, then the ports (Tunnel only), then the bottom row.
const xPowerBtn = 30 + tw(t('PowerStateRunning'), F_S);
const xTargetField = 14 + tw(t('TargetPort'), F_S);
const xLocalLabel = xTargetField + 46;
const xLocalField = xLocalLabel + tw(t('LocalPort'), F_S) + 4;

const help = wrap(t('EntraIdAuthInfo'), 46, 3);
const bottomY = mac ? 262 : 244;
const id = `s-azurevm-${platform}-${lang}`;
---
<figure class="appshot">
  <div class="frame">
    <svg viewBox="0 0 300 292" role="img" aria-labelledby={id}>
      <title id={id}>The Azure VM tab on {mac ? 'macOS' : 'Windows'}. The Bastion subscription, the signed-in account and the Bastion host sit above the tabs. The tab puts the connection method on the left and virtual machine selection on the right, with the power state, {mac ? 'the target and local port, ' : ''}the language button and Connect below.</title>

      <rect class="ui-win" x="1" y="1" width="298" height="290" rx={mac ? 8 : 6}/>
      <path class="ui-bar" d={mac ? 'M2 2 H298 V24 H2 Z' : 'M2 2 H298 V22 H2 Z'}/>

      {mac ? (
        <>
          <circle cx="14" cy="13" r="4" fill="#FF5F57"/>
          <circle cx="27" cy="13" r="4" fill="#FEBC2E"/>
          <circle cx="40" cy="13" r="4" fill="#28C840"/>
          <text class="ui-title" x="150" y="16" text-anchor="middle">{t('AppTitle')}</text>
        </>
      ) : (
        <>
          <rect x="8" y="7" width="9" height="9" rx="2" fill="#0F6CBD"/>
          <text class="ui-title" x="22" y="15">{t('AppTitle')}</text>
          <path d="M256 11 h8 M270 7 h8 v8 h-8 Z M286 7 l8 8 M294 7 l-8 8"
                stroke="#7B8794" stroke-width="1.1" fill="none"/>
        </>
      )}

      {/* Row 0 — Bastion subscription, signed-in account, Logout */}
      <text class="ui-tb" x="10" y="39" style={`font-size:${F}px`}>{t('BastionSubscription')}: Production - West Europe</text>
      <rect class="ui-btn-2" x={xChange} y="30" width={wChange} height="14" rx="3"/>
      <text class="ui-tb" x={xChange + wChange / 2} y="40" text-anchor="middle" style={`font-size:${F_S}px`}>{t('Change')}</text>

      <text class="ui-p" x="10" y="56" style={`font-size:${F_S}px`}>{t('Account')}: demo@contoso.com (Contoso Ltd.)</text>
      <rect class="ui-btn-2" x={xLogout - 20} y="47" width="14" height="14" rx="3"/>
      <text class="ui-tb" x={xLogout - 13} y="57" text-anchor="middle" style={`font-size:${F_S}px`}>i</text>
      <rect class="ui-btn-d" x={xLogout} y="47" width={wLogout} height="14" rx="3"/>
      <text class="ui-bt" x={xLogout + wLogout / 2} y="57" text-anchor="middle" style={`font-size:${F_S}px`}>{t('Logout')}</text>

      {/* Row 1 — Bastion host */}
      <text class="ui-tb" x="10" y="81" style={`font-size:${F}px`}>{t('Bastion')}</text>
      <rect class="ui-field" x={xBastionField} y="71" width={wBastionField} height="15" rx="3"/>
      <text class="ui-v" x={xBastionField + 5} y="82" style="font-size:6.4px">{fit('infra-bastion-prod-we', wBastionField, 6.4)}</text>
      <path class="ui-chev" d={`M${xBastionField + wBastionField - 11} 77 l3 3 l3 -3`}/>
      <rect class="ui-btn-2" x={xRefresh} y="71" width={wRefresh} height="15" rx="3"/>
      <text class="ui-tb" x={xRefresh + wRefresh / 2} y="82" text-anchor="middle" style={`font-size:${F_S}px`}>{t('Refresh')}</text>

      {/* Row 2 — tabs */}
      <line x1="10" y1="107" x2="290" y2="107" stroke="#DCE2EA" stroke-width="1"/>
      <text class="ui-tb off" x="10" y="103" style={`font-size:${F}px`}>{t('TabIPAddress')}</text>
      <text class="ui-tb" x={xTab2} y="103" style={`font-size:${F}px`}>{t('TabAzureVM')}</text>
      <line class="ui-tabup" x1={xTab2 - 2} y1="107" x2={xTab2 + tw(t('TabAzureVM'), F) + 2} y2="107"/>
      <text class="ui-tb off" x={xTab3} y="103" style={`font-size:${F}px`}>{t('TabActiveTunnels')}</text>

      {/* Column divider */}
      <line x1="149" y1="116" x2="149" y2="214" stroke="#B6BEC8" stroke-width="1" opacity="0.35"/>

      {/* LEFT — connection settings */}
      <text class="ui-l" x="10" y="127" style={`font-size:${F}px`}>{t('ConnectionMethod')}</text>
      <circle class={mac ? 'ui-ro on' : 'ui-ro'} cx="16" cy="137" r="4"/>
      {mac && <circle class="ui-rd" cx="16" cy="137" r="2"/>}
      <text class="ui-tb" x="24" y="140" style={`font-size:${F}px`}>{t('ConnectionMethodTunnel')}</text>
      <circle class={mac ? 'ui-ro' : 'ui-ro on'} cx={methodX2} cy="137" r="4"/>
      {!mac && <circle class="ui-rd" cx={methodX2} cy="137" r="2"/>}
      <text class="ui-tb" x={methodX2 + 8} y="140" style={`font-size:${F}px`}>{t('ConnectionMethodRDGateway')}</text>

      {/* RD Gateway only: monitor configuration and the Entra ID option */}
      {!mac && (
        <>
          <text class="ui-l" x="10" y="158" style={`font-size:${F}px`}>{t('MonitorConfiguration')}</text>
          <circle class="ui-ro on" cx="16" cy="168" r="4"/><circle class="ui-rd" cx="16" cy="168" r="2"/>
          <text class="ui-tb" x="24" y="171" style={`font-size:${F_S}px`}>{t('SingleMonitor')}</text>
          <circle class="ui-ro" cx={monitorX2} cy="168" r="4"/>
          <text class="ui-tb" x={monitorX2 + 8} y="171" style={`font-size:${F_S}px`}>{t('AllMonitors')}</text>

          <rect class="ui-ck off" x="12" y="184" width="8" height="8" rx="2"/>
          <text class="ui-tb" x="24" y="191" style={`font-size:${F_S}px`}>{t('UseEntraIdAuth')}</text>
          {help.map((line, i) => (
            <text class="ui-p" x="24" y={200 + i * 7.5} style={`font-size:${F_XS}px`}>{line}</text>
          ))}
        </>
      )}

      {/* RIGHT — virtual machine selection */}
      <text class="ui-l" x="156" y="127" style={`font-size:${F}px`}>{t('VirtualMachine')}</text>
      <circle class="ui-ro on" cx="161" cy="137" r="4"/><circle class="ui-rd" cx="161" cy="137" r="2"/>
      <text class="ui-tb" x="168" y="140" style={`font-size:${F_S}px`}>{t('SearchCurrentSubscription')}</text>
      <circle class="ui-ro" cx={vmModeX2} cy="137" r="4"/>
      <text class="ui-tb" x={vmModeX2 + 7} y="140" style={`font-size:${F_S}px`}>{t('SearchAllSubscriptions')}</text>

      <rect class="ui-field" x="156" y="146" width={wCombo} height="14" rx="3"/>
      <text class="ui-v" x="161" y="156" style="font-size:5.6px">{fit('Identity - West Europe', wCombo, 5.6)}</text>
      <path class="ui-chev" d={`M${156 + wCombo - 11} 151 l3 3 l3 -3`}/>
      <rect class="ui-btn-2" x={xRefreshVm} y="146" width={wRefreshVm} height="14" rx="3"/>
      <text class="ui-tb" x={xRefreshVm + wRefreshVm / 2} y="156" text-anchor="middle" style={`font-size:${F_S}px`}>{t('Refresh')}</text>

      <rect class="ui-field" x="156" y="164" width={wCombo} height="14" rx="3"/>
      <text class="ui-v" x="161" y="174" style="font-size:5.6px">{fit('vm-fileserver-42 (Identity)', wCombo, 5.6)}</text>
      <path class="ui-chev" d={`M${156 + wCombo - 11} 169 l3 3 l3 -3`}/>
      <rect class="ui-btn-2" x={xRefreshVm} y="164" width={wRefreshVm} height="14" rx="3"/>
      <text class="ui-tb" x={xRefreshVm + wRefreshVm / 2} y="174" text-anchor="middle" style={`font-size:${F_S}px`}>{t('Refresh')}</text>

      <rect class="ui-field" x="156" y="182" width="134" height="14" rx="3"/>
      <text class="ui-p" x="161" y="192" style={`font-size:${F_S}px`}>{t('VmSearchPlaceholder')}</text>
      <rect class="ui-field" x="156" y="200" width="134" height="14" rx="3"/>
      <text class="ui-p" x="161" y="210" style={`font-size:${F_S}px`}>{t('VmTagFilterPlaceholder')}</text>

      {/* Power state — full width, below the two columns */}
      <circle class="ui-run" cx="15" cy="225" r="3.5"/>
      <text class="ui-tb" x="23" y="228" style={`font-size:${F_S}px`}>{t('PowerStateRunning')}</text>
      <rect class="ui-btn-2" x={xPowerBtn} y="219" width="13" height="13" rx="3"/>
      <text class="ui-tb" x={xPowerBtn + 6.5} y="228" text-anchor="middle" style={`font-size:${F_S}px`}>↻</text>

      {/* Tunnel only: the port fields */}
      {mac && (
        <>
          <text class="ui-tb" x="10" y="249" style={`font-size:${F_S}px`}>{t('TargetPort')}</text>
          <rect class="ui-field" x={xTargetField} y="240" width="42" height="14" rx="3"/>
          <text class="ui-v" x={xTargetField + 5} y="250" style="font-size:6.4px">3389</text>
          <text class="ui-tb" x={xLocalLabel} y="249" style={`font-size:${F_S}px`}>{t('LocalPort')}</text>
          <rect class="ui-field" x={xLocalField} y="240" width="42" height="14" rx="3"/>
          <text class="ui-v" x={xLocalField + 5} y="250" style="font-size:6.4px">55000</text>
        </>
      )}

      {/* Language button (left) and Connect (right) */}
      <rect class="ui-btn-2" x="10" y={bottomY} width={btnW(LANG_NAME[lang], F_S, 26, 56)} height="16" rx="3"/>
      <text class="ui-p" x="16" y={bottomY + 11} style="font-size:5.2px">{LANG_FLAG[lang]}</text>
      <text class="ui-tb" x="27" y={bottomY + 11} style={`font-size:${F_S}px`}>{LANG_NAME[lang]}</text>

      <rect class="ui-btn" x={290 - btnW(t('Connect'), F, 22, 56)} y={bottomY} width={btnW(t('Connect'), F, 22, 56)} height="16" rx="3"/>
      <text class="ui-bt" x={290 - btnW(t('Connect'), F, 22, 56) / 2} y={bottomY + 11} text-anchor="middle" style={`font-size:${F}px`}>{t('Connect')}</text>
    </svg>
  </div>
  {caption && <figcaption><b>{mac ? 'macOS' : 'Windows'}</b> {caption}</figcaption>}
</figure>
